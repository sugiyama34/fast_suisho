+// AccumulatorCache (Stockfishの通称finny tables)
+// 視点から見た自玉のマスごとに accumulator と、その accumulator を構成した
+// 駒リスト (BonaPiece) を保持する。refresh 時はゼロから全計算する代わりに、
+// キャッシュ済み accumulator との差分 (エントリ保存時から動いた駒だけ) を適用する。
+// エントリの不変条件: accumulation == biases + Σ column(MakeIndex(sq_k, pieces[i]))
+// これは駒割り当て (PieceNumber) の同一性に依存しないので、別のゲーム・別の探索木の
+// エントリもそのまま差分の基点として正しい。
+struct alignas(64) AccumulatorCacheEntry {
+  std::int16_t accumulation[kTransformedFeatureDimensions];
+  BonaPiece pieces[PIECE_NUMBER_NB];
+  bool computed = false;
+};
+
+struct AccumulatorCache {
+  AccumulatorCacheEntry entries[2][SQ_NB];  // [視点][視点から見た自玉のマス]
+  std::uint32_t generation = 0;  // network_generation と不一致なら全エントリ無効
+};
+
+// 評価関数パラメータが読み直されたときにキャッシュを無効化するための世代カウンタ。
+// スレッドローカルなキャッシュの generation との不一致で無効化を検出する。
+inline std::atomic<std::uint32_t> network_generation{1};
+inline thread_local AccumulatorCache accumulator_cache;
+
 } // namespace Eval::NNUE
 } // namespace YaneuraOu
 

+// ============================================================================
+// fast_suisho experiment-011 local patch: PC-ALM (Augmented Lagrangian
+// Predictive Coding, Seely & Gould 2026) credit assignment for SFNN.
+//
+// States lifted to free variables per sample: h1 = combined (pairwise output,
+// ft_size), h2 = l1 (l1_hidden + 1), h3 = l2 (l2_size, post-crelu).
+// Residuals r1 = h1 - combined_fwd, r2 = h2 - L1(h1), r3 = h3 - crelu(L2(u(h2))),
+// supervised term = per-sample sigmoid-MSE of out = L3(h3) + h2[l1_hidden].
+// The inference loop is the reference algorithm (pcalm/inference.py,
+// run_pcalm, weight_credit_timing = pre_dual_energy) with per-sample energy:
+// T primal steps h -= eta * grad_h, T-1 dual steps lambda += alpha * r applied
+// right before primal steps 2..T. Weight gradients are the BP weight-gradient
+// reductions with the BP adjoints replaced by -(rho * r_i + lambda_i) / batch
+// and activations replaced by the settled states.
+//
+// Numerics: the states are stored as offsets from the forward pass
+// (d_i = h_i - forward_i) and every prediction is computed as forward value +
+// change, so residuals are never formed by subtracting two O(1) numbers
+// (float32 cancellation otherwise dominates the small PC-ALM credits).
+//
+// Supported: dense stacked L1 with optional shared factorizer, no axis
+// factorizer, sigmoid-MSE loss (checked on the Rust side as well).
+// ============================================================================
+
+constexpr size_t SFNN_PCALM_MAX_L2_IN = 32;
+constexpr size_t SFNN_PCALM_MAX_L2 = 128;
+
+__device__ __forceinline__ float sfnn_pcalm_crelu_mask(float value) {
+    return value > 0.0f && value < 1.0f ? 1.0f : 0.0f;
+}
+
+__device__ __forceinline__ float sfnn_pcalm_w2(
+    const float* l2w, const float* l2fw, size_t stack, size_t o, size_t i, size_t l2_size, size_t l2_in) {
+    return l2w[stack * l2_size * l2_in + o * l2_in + i] + (l2fw != nullptr ? l2fw[o * l2_in + i] : 0.0f);
+}
+
+__device__ __forceinline__ float sfnn_pcalm_w3(const float* l3w, const float* l3fw, size_t stack, size_t o, size_t l2_size) {
+    return l3w[stack * l2_size + o] + (l3fw != nullptr ? l3fw[o] : 0.0f);
+}
+
+// One thread per sample: dual (optional) + primal step for d3 and d2, and the
+// layer-2 composite credit g2 = rho * r2 + lambda2 used by the h1 step.
+__global__ void sfnn_pcalm_tail_step_kernel(
+    float* d2,
+    float* lam2,
+    float* g2_out,
+    const float* q2,
+    const float* l1_fwd,
+    const float* u,
+    float* d3,
+    float* lam3,
+    const float* p3,
+    const float* e3,
+    const float* lgrad_mean,
+    const float* l2w,
+    const float* l2fw,
+    const float* l3w,
+    const float* l3fw,
+    const int* buckets,
+    size_t batch,
+    size_t l1_hidden,
+    size_t l2_size,
+    size_t num_stacks,
+    float batch_scale,
+    float alpha,
+    float rho,
+    const float* eta_ptr,
+    int apply_dual) {
+    size_t sample = blockIdx.x * blockDim.x + threadIdx.x;
+    if (sample >= batch) {
+        return;
+    }
+    const float eta = eta_ptr[0];
+    const size_t l1_out = l1_hidden + 1;
+    const size_t l2_in = l1_hidden * 2;
+    int stack_i32 = buckets[sample];
+    if (stack_i32 < 0 || static_cast<size_t>(stack_i32) >= num_stacks) {
+        for (size_t r = 0; r < l1_out; ++r) {
+            g2_out[sample * l1_out + r] = 0.0f;
+        }
+        return;
+    }
+    const size_t stack = static_cast<size_t>(stack_i32);
+    const float lg = lgrad_mean[sample] * batch_scale;
+
+    float back[SFNN_PCALM_MAX_L2_IN];
+    for (size_t i = 0; i < SFNN_PCALM_MAX_L2_IN; ++i) {
+        back[i] = 0.0f;
+    }
+    for (size_t o = 0; o < l2_size; ++o) {
+        const size_t idx = sample * l2_size + o;
+        const float r3 = d3[idx] - e3[idx];
+        float lm = lam3[idx];
+        if (apply_dual != 0) {
+            lm += alpha * r3;
+            lam3[idx] = lm;
+        }
+        const float g3 = rho * r3 + lm;
+        const float v = sfnn_pcalm_crelu_mask(p3[idx]) * g3;
+        if (v != 0.0f) {
+            for (size_t i = 0; i < l2_in; ++i) {
+                back[i] += v * sfnn_pcalm_w2(l2w, l2fw, stack, o, i, l2_size, l2_in);
+            }
+        }
+        d3[idx] -= eta * (g3 + lg * sfnn_pcalm_w3(l3w, l3fw, stack, o, l2_size));
+    }
+    for (size_t r = 0; r < l1_out; ++r) {
+        const size_t idx = sample * l1_out + r;
+        const float r2 = d2[idx] - q2[idx];
+        float lm = lam2[idx];
+        if (apply_dual != 0) {
+            lm += alpha * r2;
+            lam2[idx] = lm;
+        }
+        const float g = rho * r2 + lm;
+        g2_out[idx] = g;
+        float grad = 0.0f;
+        if (r < l1_hidden) {
+            const float x = l1_fwd[idx] + d2[idx];
+            const float sq = u[sample * l2_in + r];
+            const float lin = u[sample * l2_in + l1_hidden + r];
+            const float jt = back[r] * sfnn_pcalm_crelu_mask(sq) * (2.0f * x * SFNN_PAIRWISE_SCALE) +
+                back[l1_hidden + r] * sfnn_pcalm_crelu_mask(lin);
+            grad = g - jt;
+        } else {
+            grad = g + lg;  // L1 -> output shortcut
+        }
+        d2[idx] -= eta * grad;
+    }
+}
+
+// One thread per (sample, ft unit): dual (optional) + primal step for d1 (= h1 - combined_fwd = r1).
+__global__ void sfnn_pcalm_ft_step_kernel(
+    float* d1,
+    float* lam1,
+    const float* g2,
+    const float* w1_eff,
+    const int* buckets,
+    size_t batch,
+    size_t ft_size,
+    size_t l1_out,
+    size_t num_stacks,
+    float alpha,
+    float rho,
+    const float* eta_ptr,
+    int apply_dual) {
+    size_t tid = blockIdx.x * blockDim.x + threadIdx.x;
+    if (tid >= batch * ft_size) {
+        return;
+    }
+    const float eta = eta_ptr[0];
+    const size_t sample = tid / ft_size;
+    const size_t j = tid - sample * ft_size;
+    int stack_i32 = buckets[sample];
+    if (stack_i32 < 0 || static_cast<size_t>(stack_i32) >= num_stacks) {
+        return;
+    }
+    const size_t stack = static_cast<size_t>(stack_i32);
+    const float r1 = d1[tid];
+    float lm = lam1[tid];
+    if (apply_dual != 0) {
+        lm += alpha * r1;
+        lam1[tid] = lm;
+    }
+    const float g1 = rho * r1 + lm;
+    const float* w = w1_eff + stack * l1_out * ft_size + j;
+    float back = 0.0f;
+    for (size_t k = 0; k < l1_out; ++k) {
+        back += w[k * ft_size] * g2[sample * l1_out + k];
+    }
+    d1[tid] = r1 - eta * (g1 - back);
+}
+
+// Effective L1 weights (stacked + shared factorizer), row-major [stack][out][in].
+__global__ void sfnn_pcalm_l1_effective_kernel(
+    const float* l1w,
+    const float* l1fw,
+    float* w_eff,
+    size_t ft_size,
+    size_t l1_out,
+    size_t num_stacks) {
+    size_t tid = blockIdx.x * blockDim.x + threadIdx.x;
+    const size_t per_stack = l1_out * ft_size;
+    if (tid >= num_stacks * per_stack) {
+        return;
+    }
+    const size_t rem = tid % per_stack;
+    const size_t o = rem / ft_size;
+    const size_t i = rem - o * ft_size;
+    w_eff[tid] = l1w[tid] + (l1fw != nullptr ? l1fw[i * l1_out + o] : 0.0f);
+}
+
+// q2 = W1eff * d1 (the change of the L1 prediction), one warp per sample.
+__global__ void sfnn_pcalm_l1_delta_warp_kernel(
+    const float* d1,
+    const float* w_eff,
+    const int* buckets,
+    float* q2,
+    size_t batch,
+    size_t ft_size,
+    size_t l1_out,
+    size_t num_stacks) {
+    const size_t warp = (static_cast<size_t>(blockIdx.x) * blockDim.x + threadIdx.x) / 32;
+    const unsigned int lane = threadIdx.x & 31U;
+    if (warp >= batch) {
+        return;
+    }
+    const size_t sample = warp;
+    int stack_i32 = buckets[sample];
+    if (stack_i32 < 0 || static_cast<size_t>(stack_i32) >= num_stacks) {
+        if (lane < l1_out) {
+            q2[sample * l1_out + lane] = 0.0f;
+        }
+        return;
+    }
+    const size_t stack = static_cast<size_t>(stack_i32);
+    const float* x = d1 + sample * ft_size;
+    for (size_t o = 0; o < l1_out; ++o) {
+        const float* w = w_eff + (stack * l1_out + o) * ft_size;
+        float acc = 0.0f;
+        for (size_t i = lane; i < ft_size; i += 32) {
+            acc += x[i] * w[i];
+        }
+        for (int off = 16; off > 0; off >>= 1) {
+            acc += __shfl_down_sync(0xffffffffU, acc, off);
+        }
+        if (lane == 0) {
+            q2[sample * l1_out + o] = acc;
+        }
+    }
+}
+
+// Per sample: u = u(l1_fwd + d2); pre3_ref (once, init != 0) = W2eff * u_fwd + b2eff;
+// p3 = crelu(pre3_ref + W2eff * (u - u_fwd)); e3 = p3 - crelu(pre3_ref);
+// out = out_fwd + W3eff . d3 + d2[l1_hidden].
+__global__ void sfnn_pcalm_tail_predict_kernel(
+    const float* l1_fwd,
+    const float* d2,
+    const float* u_fwd,
+    float* u,
+    float* pre3_ref,
+    float* p3,
+    float* e3,
+    const float* d3,
+    const float* out_fwd,
+    float* out,
+    const float* l2w,
+    const float* l2b,
+    const float* l2fw,
+    const float* l2fb,
+    const float* l3w,
+    const float* l3fw,
+    const int* buckets,
+    size_t batch,
+    size_t l1_hidden,
+    size_t l2_size,
+    size_t num_stacks,
+    int init) {
+    size_t sample = blockIdx.x * blockDim.x + threadIdx.x;
+    if (sample >= batch) {
+        return;
+    }
+    const size_t l1_out = l1_hidden + 1;
+    const size_t l2_in = l1_hidden * 2;
+    int stack_i32 = buckets[sample];
+    if (stack_i32 < 0 || static_cast<size_t>(stack_i32) >= num_stacks) {
+        out[sample] = out_fwd[sample];
+        return;
+    }
+    const size_t stack = static_cast<size_t>(stack_i32);
+    float du[SFNN_PCALM_MAX_L2_IN];
+    for (size_t r = 0; r < l1_hidden; ++r) {
+        const float x = l1_fwd[sample * l1_out + r] + d2[sample * l1_out + r];
+        const float ax = fabsf(x);
+        const float sq = crelu(ax * ax * SFNN_PAIRWISE_SCALE);
+        const float lin = crelu(x);
+        u[sample * l2_in + r] = sq;
+        u[sample * l2_in + l1_hidden + r] = lin;
+        du[r] = sq - u_fwd[sample * l2_in + r];
+        du[l1_hidden + r] = lin - u_fwd[sample * l2_in + l1_hidden + r];
+    }
+    float o_acc = 0.0f;
+    for (size_t o = 0; o < l2_size; ++o) {
+        const size_t idx = sample * l2_size + o;
+        if (init != 0) {
+            float pre = l2b[stack * l2_size + o] + (l2fb != nullptr ? l2fb[o] : 0.0f);
+            for (size_t i = 0; i < l2_in; ++i) {
+                pre += sfnn_pcalm_w2(l2w, l2fw, stack, o, i, l2_size, l2_in) * u_fwd[sample * l2_in + i];
+            }
+            pre3_ref[idx] = pre;
+        }
+        float delta = 0.0f;
+        for (size_t i = 0; i < l2_in; ++i) {
+            if (du[i] != 0.0f) {
+                delta += sfnn_pcalm_w2(l2w, l2fw, stack, o, i, l2_size, l2_in) * du[i];
+            }
+        }
+        const float base = pre3_ref[idx];
+        const float p = crelu(base + delta);
+        p3[idx] = p;
+        e3[idx] = p - crelu(base);
+        o_acc += sfnn_pcalm_w3(l3w, l3fw, stack, o, l2_size) * d3[idx];
+    }
+    out[sample] = out_fwd[sample] + o_acc + d2[sample * l1_out + l1_hidden];
+}
+
+// delta = scale * (rho * (d - q) + lambda) with q optional (nullptr = 0); scale = -1 / batch
+// turns the per-sample composite credit into a batch-mean BP-style output gradient.
+__global__ void sfnn_pcalm_credit_kernel(
+    const float* d,
+    const float* q,
+    const float* lam,
+    float* delta,
+    size_t len,
+    float rho,
+    float scale) {
+    size_t tid = blockIdx.x * blockDim.x + threadIdx.x;
+    if (tid >= len) {
+        return;
+    }
+    const float r = d[tid] - (q != nullptr ? q[tid] : 0.0f);
+    delta[tid] = scale * (rho * r + lam[tid]);
+}
+
+// dst = base + d (absolute settled states for the weight-gradient reductions).
+__global__ void sfnn_pcalm_add_kernel(const float* base, const float* d, float* dst, size_t len) {
+    size_t tid = blockIdx.x * blockDim.x + threadIdx.x;
+    if (tid >= len) {
+        return;
+    }
+    dst[tid] = base[tid] + d[tid];
+}
+
+// Largest eigenvalue of a small symmetric PSD matrix (n <= 16) by power iteration.
+__device__ float sfnn_pcalm_sym_lambda_max(const float* g, int n) {
+    float v[16];
+    for (int i = 0; i < n; ++i) {
+        v[i] = 1.0f + 0.01f * static_cast<float>(i);
+    }
+    float lambda = 0.0f;
+    for (int it = 0; it < 100; ++it) {
+        float w[16];
+        float norm = 0.0f;
+        for (int i = 0; i < n; ++i) {
+            float acc = 0.0f;
+            for (int j = 0; j < n; ++j) {
+                acc += g[i * n + j] * v[j];
+            }
+            w[i] = acc;
+            norm += acc * acc;
+        }
+        norm = sqrtf(norm);
+        if (norm <= 0.0f) {
+            return 0.0f;
+        }
+        float dot = 0.0f;
+        for (int i = 0; i < n; ++i) {
+            dot += w[i] * v[i];
+            v[i] = w[i] / norm;
+        }
+        lambda = dot;
+    }
+    return lambda;
+}
+
+// eta_out[0] = eta used by the inference loop; [1], [2], [3] = lambda_1, lambda_3, lambda_2 (diagnostics;
+// [3] is accumulated per sample by sfnn_pcalm_lambda2_kernel before this kernel runs).
+// Fixed mode (auto_scale <= 0): eta = fixed_eta. Auto mode: eta = auto_scale / (1.05 * max(lambda_1, lambda_2, lambda_3))
+//   lambda_1 = rho * (1 + max_s sigma_max(W1eff_s)^2)   (the h1 block: rho * (I + W1^T W1)),
+//   lambda_3 = rho + 0.35 * max_s |W3eff_s|^2          (0.35 bounds the sigmoid-MSE curvature),
+//   lambda_2 = max over the batch of rho * (1 + sigma_max(J3)^2) (sfnn_pcalm_lambda2_kernel),
+// i.e. the reference rule eta = 1 / lambda_max (block-wise estimate), tracked as the weights grow.
+__global__ void sfnn_pcalm_eta_kernel(
+    const float* w1_eff,
+    const float* l3w,
+    const float* l3fw,
+    float* eta_out,
+    size_t ft_size,
+    size_t l1_out,
+    size_t l2_size,
+    size_t num_stacks,
+    float rho,
+    float fixed_eta,
+    float auto_scale) {
+    if (blockIdx.x != 0 || threadIdx.x != 0) {
+        return;
+    }
+    if (auto_scale <= 0.0f) {
+        eta_out[0] = fixed_eta;
+        eta_out[1] = 0.0f;
+        eta_out[2] = 0.0f;
+        return;
+    }
+    float lam1 = 0.0f;
+    float lam3 = 0.0f;
+    for (size_t s = 0; s < num_stacks; ++s) {
+        float g[16 * 16];
+        const float* w = w1_eff + s * l1_out * ft_size;
+        for (size_t a = 0; a < l1_out; ++a) {
+            for (size_t b = a; b < l1_out; ++b) {
+                float acc = 0.0f;
+                for (size_t i = 0; i < ft_size; ++i) {
+                    acc += w[a * ft_size + i] * w[b * ft_size + i];
+                }
+                g[a * l1_out + b] = acc;
+                g[b * l1_out + a] = acc;
+            }
+        }
+        lam1 = fmaxf(lam1, rho * (1.0f + sfnn_pcalm_sym_lambda_max(g, static_cast<int>(l1_out))));
+        float w3sq = 0.0f;
+        for (size_t o = 0; o < l2_size; ++o) {
+            const float w3 = sfnn_pcalm_w3(l3w, l3fw, s, o, l2_size);
+            w3sq += w3 * w3;
+        }
+        lam3 = fmaxf(lam3, rho + 0.35f * w3sq);
+    }
+    eta_out[0] = auto_scale / (1.05f * fmaxf(fmaxf(lam1, lam3), eta_out[3]));
+    eta_out[1] = lam1;
+    eta_out[2] = lam3;
+}
+
+// Per sample at the forward state: lambda_2 = rho * (1 + sigma_max(J3)^2) with J3 = d crelu(L2(u(h2))) / d h2
+// (masks from the forward values), and max(lambda_2, rho + 0.35) for the shortcut entry. The batch maximum is
+// accumulated into eta_buf[3] (positive floats compare like their int bit patterns).
+__global__ void sfnn_pcalm_lambda2_kernel(
+    const float* l1_fwd,
+    const float* u,
+    const float* p3,
+    const float* l2w,
+    const float* l2fw,
+    const int* buckets,
+    float* eta_buf,
+    size_t batch,
+    size_t l1_hidden,
+    size_t l2_size,
+    size_t num_stacks,
+    float rho) {
+    size_t sample = blockIdx.x * blockDim.x + threadIdx.x;
+    if (sample >= batch) {
+        return;
+    }
+    int stack_i32 = buckets[sample];
+    if (stack_i32 < 0 || static_cast<size_t>(stack_i32) >= num_stacks) {
+        return;
+    }
+    const size_t stack = static_cast<size_t>(stack_i32);
+    const size_t l1_out = l1_hidden + 1;
+    const size_t l2_in = l1_hidden * 2;
+    float dsq[16];
+    float dlin[16];
+    for (size_t r = 0; r < l1_hidden; ++r) {
+        const float x = l1_fwd[sample * l1_out + r];
+        dsq[r] = sfnn_pcalm_crelu_mask(u[sample * l2_in + r]) * 2.0f * x * SFNN_PAIRWISE_SCALE;
+        dlin[r] = sfnn_pcalm_crelu_mask(u[sample * l2_in + l1_hidden + r]);
+    }
+    float g[16 * 16];
+    for (size_t i = 0; i < l1_hidden * l1_hidden; ++i) {
+        g[i] = 0.0f;
+    }
+    for (size_t o = 0; o < l2_size; ++o) {
+        if (sfnn_pcalm_crelu_mask(p3[sample * l2_size + o]) == 0.0f) {
+            continue;
+        }
+        float j[16];
+        for (size_t r = 0; r < l1_hidden; ++r) {
+            j[r] = sfnn_pcalm_w2(l2w, l2fw, stack, o, r, l2_size, l2_in) * dsq[r] +
+                sfnn_pcalm_w2(l2w, l2fw, stack, o, l1_hidden + r, l2_size, l2_in) * dlin[r];
+        }
+        for (size_t a = 0; a < l1_hidden; ++a) {
+            for (size_t b = 0; b < l1_hidden; ++b) {
+                g[a * l1_hidden + b] += j[a] * j[b];
+            }
+        }
+    }
+    const float lam2 = fmaxf(rho * (1.0f + sfnn_pcalm_sym_lambda_max(g, static_cast<int>(l1_hidden))), rho + 0.35f);
+    atomicMax(reinterpret_cast<int*>(eta_buf + 3), __float_as_int(lam2));
+}
+
+// ---------------------------------------------------------------------------- optimized kernels
+// Layout of the "eff" scratch buffer: [W1eff S*l1_out*ft][W2eff S*l2*l2in][b2eff S*l2][W3eff S*l2].
+constexpr unsigned int SFNN_PCALM_TAIL_SAMPLES = 4;  // samples per block in the tail kernels
+constexpr unsigned int SFNN_PCALM_TAIL_LANES = 64;   // threads per sample (one per L2 output, l2_size <= 64)
+
+__global__ void sfnn_pcalm_tail_effective_kernel(
+    const float* l2w,
+    const float* l2b,
+    const float* l2fw,
+    const float* l2fb,
+    const float* l3w,
+    const float* l3fw,
+    float* w2_eff,
+    float* b2_eff,
+    float* w3_eff,
+    size_t l2_size,
+    size_t l2_in,
+    size_t num_stacks) {
+    size_t tid = blockIdx.x * blockDim.x + threadIdx.x;
+    if (tid < num_stacks * l2_size * l2_in) {
+        const size_t rem = tid % (l2_size * l2_in);
+        w2_eff[tid] = l2w[tid] + (l2fw != nullptr ? l2fw[rem] : 0.0f);
+    }
+    if (tid < num_stacks * l2_size) {
+        const size_t o = tid % l2_size;
+        b2_eff[tid] = l2b[tid] + (l2fb != nullptr ? l2fb[o] : 0.0f);
+        w3_eff[tid] = l3w[tid] + (l3fw != nullptr ? l3fw[o] : 0.0f);
+    }
+}
+
+__device__ __forceinline__ float sfnn_pcalm_warp_sum(float v) {
+    for (int off = 16; off > 0; off >>= 1) {
+        v += __shfl_down_sync(0xffffffffU, v, off);
+    }
+    return v;
+}
+
+// Predictions for the tail, one thread per (sample, L2 output). Same math as sfnn_pcalm_tail_predict_kernel.
+__global__ void sfnn_pcalm_tail_predict_v2_kernel(
+    const float* l1_fwd,
+    const float* d2,
+    const float* u_fwd,
+    float* u,
+    float* pre3_ref,
+    float* p3,
+    float* e3,
+    const float* d3,
+    const float* out_fwd,
+    float* out,
+    const float* w2_eff,
+    const float* b2_eff,
+    const float* w3_eff,
+    const int* buckets,
+    size_t batch,
+    size_t l1_hidden,
+    size_t l2_size,
+    size_t num_stacks,
+    int init) {
+    __shared__ float partial[SFNN_PCALM_TAIL_SAMPLES][2];
+    const unsigned int local = threadIdx.x / SFNN_PCALM_TAIL_LANES;
+    const unsigned int o = threadIdx.x % SFNN_PCALM_TAIL_LANES;
+    const size_t sample = static_cast<size_t>(blockIdx.x) * SFNN_PCALM_TAIL_SAMPLES + local;
+    const bool in_batch = sample < batch;
+    const int stack_i32 = in_batch ? buckets[sample] : -1;
+    const bool valid = stack_i32 >= 0 && static_cast<size_t>(stack_i32) < num_stacks;
+    const size_t stack = valid ? static_cast<size_t>(stack_i32) : 0;
+    const size_t l1_out = l1_hidden + 1;
+    const size_t l2_in = l1_hidden * 2;
+    float contrib = 0.0f;
+    if (valid && o < l2_size) {
+        float du[SFNN_PCALM_MAX_L2_IN];
+        for (size_t r = 0; r < l1_hidden; ++r) {
+            const float x = l1_fwd[sample * l1_out + r] + d2[sample * l1_out + r];
+            const float ax = fabsf(x);
+            const float sq = crelu(ax * ax * SFNN_PAIRWISE_SCALE);
+            const float lin = crelu(x);
+            du[r] = sq - u_fwd[sample * l2_in + r];
+            du[l1_hidden + r] = lin - u_fwd[sample * l2_in + l1_hidden + r];
+            if (o == r) {
+                u[sample * l2_in + r] = sq;
+            }
+            if (o == l1_hidden + r) {
+                u[sample * l2_in + l1_hidden + r] = lin;
+            }
+        }
+        const float* w = w2_eff + (stack * l2_size + o) * l2_in;
+        const size_t idx = sample * l2_size + o;
+        float base;
+        if (init != 0) {
+            base = b2_eff[stack * l2_size + o];
+            for (size_t i = 0; i < l2_in; ++i) {
+                base += w[i] * u_fwd[sample * l2_in + i];
+            }
+            pre3_ref[idx] = base;
+        } else {
+            base = pre3_ref[idx];
+        }
+        float delta = 0.0f;
+        for (size_t i = 0; i < l2_in; ++i) {
+            delta += w[i] * du[i];
+        }
+        const float pv = crelu(base + delta);
+        p3[idx] = pv;
+        e3[idx] = pv - crelu(base);
+        contrib = w3_eff[stack * l2_size + o] * d3[idx];
+    }
+    contrib = sfnn_pcalm_warp_sum(contrib);
+    if ((o & 31U) == 0) {
+        partial[local][o >> 5] = contrib;
+    }
+    __syncthreads();
+    if (in_batch && o == 0) {
+        out[sample] = valid ? out_fwd[sample] + partial[local][0] + partial[local][1] + d2[sample * l1_out + l1_hidden]
+                            : out_fwd[sample];
+    }
+}
+
+// Dual (optional) + primal step for d3 and d2, one thread per (sample, L2 output).
+// Same math as sfnn_pcalm_tail_step_kernel.
+__global__ void sfnn_pcalm_tail_step_v2_kernel(
+    float* d2,
+    float* lam2,
+    float* g2_out,
+    const float* q2,
+    const float* l1_fwd,
+    const float* u,
+    float* d3,
+    float* lam3,
+    const float* p3,
+    const float* e3,
+    const float* lgrad_mean,
+    const float* w2_eff,
+    const float* w3_eff,
+    const int* buckets,
+    size_t batch,
+    size_t l1_hidden,
+    size_t l2_size,
+    size_t num_stacks,
+    float batch_scale,
+    float alpha,
+    float rho,
+    const float* eta_ptr,
+    int apply_dual) {
+    __shared__ float back_sh[SFNN_PCALM_TAIL_SAMPLES][2][SFNN_PCALM_MAX_L2_IN];
+    const unsigned int local = threadIdx.x / SFNN_PCALM_TAIL_LANES;
+    const unsigned int o = threadIdx.x % SFNN_PCALM_TAIL_LANES;
+    const size_t sample = static_cast<size_t>(blockIdx.x) * SFNN_PCALM_TAIL_SAMPLES + local;
+    const bool in_batch = sample < batch;
+    const int stack_i32 = in_batch ? buckets[sample] : -1;
+    const bool valid = stack_i32 >= 0 && static_cast<size_t>(stack_i32) < num_stacks;
+    const size_t stack = valid ? static_cast<size_t>(stack_i32) : 0;
+    const size_t l1_out = l1_hidden + 1;
+    const size_t l2_in = l1_hidden * 2;
+    const float eta = eta_ptr[0];
+    const float lg = in_batch ? lgrad_mean[sample] * batch_scale : 0.0f;
+    float v = 0.0f;
+    if (valid && o < l2_size) {
+        const size_t idx = sample * l2_size + o;
+        const float r3 = d3[idx] - e3[idx];
+        float lm = lam3[idx];
+        if (apply_dual != 0) {
+            lm += alpha * r3;
+            lam3[idx] = lm;
+        }
+        const float g3 = rho * r3 + lm;
+        v = sfnn_pcalm_crelu_mask(p3[idx]) * g3;
+        d3[idx] -= eta * (g3 + lg * w3_eff[stack * l2_size + o]);
+    }
+    const float* w = w2_eff + (stack * l2_size + (o < l2_size ? o : 0)) * l2_in;
+    for (size_t i = 0; i < l2_in; ++i) {
+        const float s = sfnn_pcalm_warp_sum(v * w[i]);
+        if ((o & 31U) == 0) {
+            back_sh[local][o >> 5][i] = s;
+        }
+    }
+    __syncthreads();
+    if (!valid) {
+        if (in_batch && o < l1_out) {
+            g2_out[sample * l1_out + o] = 0.0f;
+        }
+        return;
+    }
+    if (o < l1_out) {
+        const size_t idx = sample * l1_out + o;
+        const float r2 = d2[idx] - q2[idx];
+        float lm = lam2[idx];
+        if (apply_dual != 0) {
+            lm += alpha * r2;
+            lam2[idx] = lm;
+        }
+        const float g = rho * r2 + lm;
+        g2_out[idx] = g;
+        float grad = 0.0f;
+        if (o < l1_hidden) {
+            const float x = l1_fwd[idx] + d2[idx];
+            const float sq = u[sample * l2_in + o];
+            const float lin = u[sample * l2_in + l1_hidden + o];
+            const float b_sq = back_sh[local][0][o] + back_sh[local][1][o];
+            const float b_lin = back_sh[local][0][l1_hidden + o] + back_sh[local][1][l1_hidden + o];
+            const float jt = b_sq * sfnn_pcalm_crelu_mask(sq) * (2.0f * x * SFNN_PAIRWISE_SCALE) +
+                b_lin * sfnn_pcalm_crelu_mask(lin);
+            grad = g - jt;
+        } else {
+            grad = g + lg;  // L1 -> output shortcut
+        }
+        d2[idx] -= eta * grad;
+    }
+}
+
+// Dual (optional) + primal step for d1 fused with q2 = W1eff * d1_new; one warp per sample.
+__global__ void sfnn_pcalm_ft_step_q2_kernel(
+    float* d1,
+    float* lam1,
+    const float* g2,
+    const float* w1_eff,
+    float* q2,
+    const int* buckets,
+    size_t batch,
+    size_t ft_size,
+    size_t l1_out,
+    size_t num_stacks,
+    float alpha,
+    float rho,
+    const float* eta_ptr,
+    int apply_dual) {
+    const size_t sample = (static_cast<size_t>(blockIdx.x) * blockDim.x + threadIdx.x) / 32;
+    const unsigned int lane = threadIdx.x & 31U;
+    if (sample >= batch) {
+        return;
+    }
+    const int stack_i32 = buckets[sample];
+    if (stack_i32 < 0 || static_cast<size_t>(stack_i32) >= num_stacks) {
+        if (lane < l1_out) {
+            q2[sample * l1_out + lane] = 0.0f;
+        }
+        return;
+    }
+    const size_t stack = static_cast<size_t>(stack_i32);
+    const float eta = eta_ptr[0];
+    float gk[16];
+    float qk[16];
+    for (size_t k = 0; k < l1_out; ++k) {
+        gk[k] = g2[sample * l1_out + k];
+        qk[k] = 0.0f;
+    }
+    const float* w = w1_eff + stack * l1_out * ft_size;
+    float* dd = d1 + sample * ft_size;
+    float* ll = lam1 + sample * ft_size;
+    for (size_t j = lane; j < ft_size; j += 32) {
+        const float r1 = dd[j];
+        float lm = ll[j];
+        if (apply_dual != 0) {
+            lm += alpha * r1;
+            ll[j] = lm;
+        }
+        float back = 0.0f;
+        for (size_t k = 0; k < l1_out; ++k) {
+            back += w[k * ft_size + j] * gk[k];
+        }
+        const float dn = r1 - eta * (rho * r1 + lm - back);
+        dd[j] = dn;
+        for (size_t k = 0; k < l1_out; ++k) {
+            qk[k] += w[k * ft_size + j] * dn;
+        }
+    }
+    for (size_t k = 0; k < l1_out; ++k) {
+        const float sum = sfnn_pcalm_warp_sum(qk[k]);
+        if (lane == 0) {
+            q2[sample * l1_out + k] = sum;
+        }
+    }
+}
+
+// lambda_1 / lambda_3 per stack in parallel (one block per stack), accumulated with atomicMax into
+// eta_out[1] / eta_out[2] (zeroed beforehand). Same estimate as sfnn_pcalm_eta_kernel.
+__global__ void sfnn_pcalm_lambda13_kernel(
+    const float* w1_eff,
+    const float* w3_eff,
+    float* eta_out,
+    size_t ft_size,
+    size_t l1_out,
+    size_t l2_size,
+    float rho) {
+    __shared__ float gram_sh[16 * 16];
+    const size_t s = blockIdx.x;
+    const float* w = w1_eff + s * l1_out * ft_size;
+    for (size_t e = threadIdx.x; e < l1_out * l1_out; e += blockDim.x) {
+        gram_sh[e] = 0.0f;
+    }
+    __syncthreads();
+    for (size_t a = 0; a < l1_out; ++a) {
+        for (size_t b = a; b < l1_out; ++b) {
+            float acc = 0.0f;
+            for (size_t i = threadIdx.x; i < ft_size; i += blockDim.x) {
+                acc += w[a * ft_size + i] * w[b * ft_size + i];
+            }
+            acc = sfnn_pcalm_warp_sum(acc);
+            if ((threadIdx.x & 31U) == 0) {
+                atomicAdd(&gram_sh[a * l1_out + b], acc);
+            }
+        }
+    }
+    __syncthreads();
+    if (threadIdx.x == 0) {
+        float g[16 * 16];
+        for (size_t a = 0; a < l1_out; ++a) {
+            for (size_t b = a; b < l1_out; ++b) {
+                g[a * l1_out + b] = gram_sh[a * l1_out + b];
+                g[b * l1_out + a] = gram_sh[a * l1_out + b];
+            }
+        }
+        const float lam1 = rho * (1.0f + sfnn_pcalm_sym_lambda_max(g, static_cast<int>(l1_out)));
+        float w3sq = 0.0f;
+        for (size_t o = 0; o < l2_size; ++o) {
+            const float x = w3_eff[s * l2_size + o];
+            w3sq += x * x;
+        }
+        const float lam3 = rho + 0.35f * w3sq;
+        atomicMax(reinterpret_cast<int*>(eta_out + 1), __float_as_int(lam1));
+        atomicMax(reinterpret_cast<int*>(eta_out + 2), __float_as_int(lam3));
+    }
+}
+
+__global__ void sfnn_pcalm_eta_finalize_kernel(float* eta_out, float fixed_eta, float auto_scale) {
+    if (blockIdx.x != 0 || threadIdx.x != 0) {
+        return;
+    }
+    if (auto_scale <= 0.0f) {
+        eta_out[0] = fixed_eta;
+        return;
+    }
+    eta_out[0] = auto_scale / (1.05f * fmaxf(fmaxf(eta_out[1], eta_out[2]), eta_out[3]));
+}
+
+// lambda_2 (per sample) with precomputed W2eff and fewer power iterations; same estimate as
+// sfnn_pcalm_lambda2_kernel.
+__global__ void sfnn_pcalm_lambda2_v2_kernel(
+    const float* l1_fwd,
+    const float* u,
+    const float* p3,
+    const float* w2_eff,
+    const int* buckets,
+    float* eta_buf,
+    size_t batch,
+    size_t l1_hidden,
+    size_t l2_size,
+    size_t num_stacks,
+    float rho) {
+    size_t sample = blockIdx.x * blockDim.x + threadIdx.x;
+    if (sample >= batch) {
+        return;
+    }
+    int stack_i32 = buckets[sample];
+    if (stack_i32 < 0 || static_cast<size_t>(stack_i32) >= num_stacks) {
+        return;
+    }
+    const size_t stack = static_cast<size_t>(stack_i32);
+    const size_t l1_out = l1_hidden + 1;
+    const size_t l2_in = l1_hidden * 2;
+    float dsq[16];
+    float dlin[16];
+    for (size_t r = 0; r < l1_hidden; ++r) {
+        const float x = l1_fwd[sample * l1_out + r];
+        dsq[r] = sfnn_pcalm_crelu_mask(u[sample * l2_in + r]) * 2.0f * x * SFNN_PAIRWISE_SCALE;
+        dlin[r] = sfnn_pcalm_crelu_mask(u[sample * l2_in + l1_hidden + r]);
+    }
+    float g[16 * 16];
+    for (size_t i = 0; i < l1_hidden * l1_hidden; ++i) {
+        g[i] = 0.0f;
+    }
+    for (size_t o = 0; o < l2_size; ++o) {
+        if (sfnn_pcalm_crelu_mask(p3[sample * l2_size + o]) == 0.0f) {
+            continue;
+        }
+        const float* w = w2_eff + (stack * l2_size + o) * l2_in;
+        float j[16];
+        for (size_t r = 0; r < l1_hidden; ++r) {
+            j[r] = w[r] * dsq[r] + w[l1_hidden + r] * dlin[r];
+        }
+        for (size_t a = 0; a < l1_hidden; ++a) {
+            for (size_t b = 0; b < l1_hidden; ++b) {
+                g[a * l1_hidden + b] += j[a] * j[b];
+            }
+        }
+    }
+    const float lam2 = fmaxf(rho * (1.0f + sfnn_pcalm_sym_lambda_max(g, static_cast<int>(l1_hidden))), rho + 0.35f);
+    atomicMax(reinterpret_cast<int*>(eta_buf + 3), __float_as_int(lam2));
+}
+
+// Fused credit + absolute state for h1: delta = scale * (rho * d1 + lam1); lam1 <- combined + d1.
+__global__ void sfnn_pcalm_credit_h1_kernel(
+    const float* d1, float* lam1_then_h1, const float* combined, float* delta, size_t len, float rho, float scale) {
+    size_t tid = blockIdx.x * blockDim.x + threadIdx.x;
+    if (tid >= len) {
+        return;
+    }
+    const float r = d1[tid];
+    delta[tid] = scale * (rho * r + lam1_then_h1[tid]);
+    lam1_then_h1[tid] = combined[tid] + r;
+}
+
+int sfnn_pcalm_copy(BulletOuCudaCppContext* ctx, float* dst, const float* src, size_t len, const char* label) {
+    if (len == 0) {
+        return 0;
+    }
+    cudaError_t status = cudaMemcpyAsync(dst, src, len * sizeof(float), cudaMemcpyDeviceToDevice, ctx->stream);
+    if (status != cudaSuccess) {
+        return fail(label, status);
+    }
+    return 0;
+}
+
+int sfnn_pcalm_zero(BulletOuCudaCppContext* ctx, float* dst, size_t len, const char* label) {
+    if (len == 0) {
+        return 0;
+    }
+    cudaError_t status = cudaMemsetAsync(dst, 0, len * sizeof(float), ctx->stream);
+    if (status != cudaSuccess) {
+        return fail(label, status);
+    }
+    return 0;
+}

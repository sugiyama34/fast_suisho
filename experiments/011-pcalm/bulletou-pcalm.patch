+            num_stacks,
+            l1_group_count,
+            l1_common_size,
+            l1_shard_size,
+            factorizer_king_axis_dim,
+            factorizer_hand_axis_dim,
+            batch,
+            max_active) != 0) {
+        return -1;
+    }
+    if (sfnn_is_common_shard_l1_shape(l1_common_size, l1_shard_size) || sfnn_is_grouped_l1_shape(l1_group_count)) {
+        return fail_message("PC-ALM supports dense stacked SFNN L1 only");
+    }
+    if (num_stacks > SFNN_DENSE_REDUCE_MAX_FAST_STACKS) {
+        return fail_message("PC-ALM requires the dense parameter-reduce fast path (too many stacks)");
+    }
+    if (l1_hidden * 2 > SFNN_PCALM_MAX_L2_IN || l1_hidden + 1 > 16 || l2_size > SFNN_PCALM_TAIL_LANES) {
+        return fail_message("PC-ALM: layer sizes out of range");
+    }
+    if (steps == 0) {
+        return fail_message("PC-ALM steps must be at least 1");
+    }
+    if (!(std::isfinite(alpha) && std::isfinite(rho) && std::isfinite(eta) && std::isfinite(eta_auto_scale)) ||
+        rho < 0.0f || alpha < 0.0f || (eta_auto_scale <= 0.0f && eta <= 0.0f)) {
+        return fail_message("PC-ALM alpha/rho/eta must be finite, rho >= 0, alpha >= 0, and eta > 0 or eta_auto_scale > 0");
+    }
+    const size_t l1_out = l1_hidden + 1;
+    const size_t l2_in = l1_hidden * 2;
+    struct Need {
+        size_t have;
+        size_t want;
+        const char* name;
+    };
+    const Need needs[] = {
+        {d1->len, batch * ft_size, "pcalm d1"},
+        {lam1->len, batch * ft_size, "pcalm lam1"},
+        {d2->len, batch * l1_out, "pcalm d2"},
+        {lam2->len, batch * l1_out, "pcalm lam2"},
+        {q2->len, batch * l1_out, "pcalm q2"},
+        {g2->len, batch * l1_out, "pcalm g2"},
+        {u->len, batch * l2_in, "pcalm u"},
+        {d3->len, batch * l2_size, "pcalm d3"},
+        {lam3->len, batch * l2_size, "pcalm lam3"},
+        {p3->len, batch * l2_size, "pcalm p3"},
+        {e3->len, batch * l2_size, "pcalm e3"},
+        {pre3_ref->len, batch * l2_size, "pcalm pre3_ref"},
+        {out->len, batch, "pcalm out"},
+        {lgrad->len, batch, "pcalm lgrad"},
+        {lps->len, batch, "pcalm lps"},
+        {w1_eff_buf->len, num_stacks * (l1_out * ft_size + l2_size * l2_in + 2 * l2_size), "pcalm eff weights"},
+        {eta_buf->len, 4, "pcalm eta"},
+        {combined->len, batch * ft_size, "pcalm combined"},
+        {l1->len, batch * l1_out, "pcalm l1"},
+        {l2_input->len, batch * l2_in, "pcalm l2_input"},
+        {l2->len, batch * l2_size, "pcalm l2"},
+        {output->len, batch, "pcalm output"},
+        {l2_gradients->len, batch * l2_size, "pcalm l2_gradients"},
+        {l1_gradients->len, batch * l1_out, "pcalm l1_gradients"},
+        {combined_gradients->len, batch * ft_size, "pcalm combined_gradients"},
+        {targets->len, batch, "pcalm targets"},
+        {entry_weights->len, batch, "pcalm entry_weights"},
+        {mean_output_gradients->len, batch, "pcalm mean_output_gradients"},
+    };
+    for (const Need& n : needs) {
+        if (n.have < n.want) {
+            return fail_message(n.name);
+        }
+    }
+    if (set_context_device(ctx) != 0) {
+        return -1;
+    }
+
+    const float* w1f = has_l1f != 0 ? l1fw->ptr : nullptr;
+    const float* w2f = has_l2f != 0 ? l2fw->ptr : nullptr;
+    const float* b2f = has_l2f != 0 ? l2fb->ptr : nullptr;
+    const float* w3f = has_l3f != 0 ? l3fw->ptr : nullptr;
+    constexpr int threads = 256;
+    int blocks = 0;
+
+    // Effective weights (L1 / L2 / L3 with the shared factorizer folded in), computed once per mini-batch.
+    const size_t n_w1 = num_stacks * l1_out * ft_size;
+    float* w1_eff = w1_eff_buf->ptr;
+    float* w2_eff = w1_eff + n_w1;
+    float* b2_eff = w2_eff + num_stacks * l2_size * l2_in;
+    float* w3_eff = b2_eff + num_stacks * l2_size;
+    if (block_count_1d(n_w1, threads, &blocks, "sfnn_pcalm_l1_effective_kernel") != 0) {
+        return -1;
+    }
+    sfnn_pcalm_l1_effective_kernel<<<blocks, threads, 0, ctx->stream>>>(
+        l1w->ptr, w1f, w1_eff, ft_size, l1_out, num_stacks);
+    if (block_count_1d(num_stacks * l2_size * l2_in, threads, &blocks, "sfnn_pcalm_tail_effective_kernel") != 0) {
+        return -1;
+    }
+    sfnn_pcalm_tail_effective_kernel<<<blocks, threads, 0, ctx->stream>>>(
+        l2w->ptr, l2b->ptr, w2f, b2f, l3w->ptr, w3f, w2_eff, b2_eff, w3_eff, l2_size, l2_in, num_stacks);
+    if (check_kernel_launch("sfnn_pcalm effective weights launch") != 0) {
+        return -1;
+    }
+
+    // Offsets from the forward pass start at zero; duals at zero.
+    if (sfnn_pcalm_zero(ctx, d1->ptr, batch * ft_size, "pcalm zero d1") != 0 ||
+        sfnn_pcalm_zero(ctx, d2->ptr, batch * l1_out, "pcalm zero d2") != 0 ||
+        sfnn_pcalm_zero(ctx, d3->ptr, batch * l2_size, "pcalm zero d3") != 0 ||
+        sfnn_pcalm_zero(ctx, q2->ptr, batch * l1_out, "pcalm zero q2") != 0 ||
+        sfnn_pcalm_zero(ctx, lam1->ptr, batch * ft_size, "pcalm zero lam1") != 0 ||
+        sfnn_pcalm_zero(ctx, lam2->ptr, batch * l1_out, "pcalm zero lam2") != 0 ||
+        sfnn_pcalm_zero(ctx, lam3->ptr, batch * l2_size, "pcalm zero lam3") != 0 ||
+        sfnn_pcalm_zero(ctx, eta_buf->ptr, 4, "pcalm zero eta") != 0 ||
+        sfnn_pcalm_copy(ctx, lgrad->ptr, mean_output_gradients->ptr, batch, "pcalm copy lgrad") != 0) {
+        return -1;
+    }
+    const unsigned int tail_threads = SFNN_PCALM_TAIL_SAMPLES * SFNN_PCALM_TAIL_LANES;
+    const int tail_blocks = static_cast<int>((batch + SFNN_PCALM_TAIL_SAMPLES - 1) / SFNN_PCALM_TAIL_SAMPLES);
+    int sample_blocks = 0;
+    int warp_blocks = 0;
+    if (block_count_1d(batch, threads, &sample_blocks, "sfnn_pcalm sample") != 0 ||
+        block_count_1d(batch * 32, threads, &warp_blocks, "sfnn_pcalm warp") != 0) {
+        return -1;
+    }
+    // Initial predictions (u, pre3_ref, p3, e3 = 0, out = out_fwd).
+    sfnn_pcalm_tail_predict_v2_kernel<<<tail_blocks, tail_threads, 0, ctx->stream>>>(
+        l1->ptr, d2->ptr, l2_input->ptr, u->ptr, pre3_ref->ptr, p3->ptr, e3->ptr, d3->ptr, output->ptr, out->ptr,
+        w2_eff, b2_eff, w3_eff, buckets->ptr, batch, l1_hidden, l2_size, num_stacks, 1);
+    // Step size for this mini-batch (fixed, or the block-wise lambda_max estimate at the forward state).
+    if (eta_auto_scale > 0.0f) {
+        sfnn_pcalm_lambda2_v2_kernel<<<sample_blocks, threads, 0, ctx->stream>>>(
+            l1->ptr, u->ptr, p3->ptr, w2_eff, buckets->ptr, eta_buf->ptr, batch, l1_hidden, l2_size, num_stacks, rho);
+        sfnn_pcalm_lambda13_kernel<<<static_cast<unsigned int>(num_stacks), 256, 0, ctx->stream>>>(
+            w1_eff, w3_eff, eta_buf->ptr, ft_size, l1_out, l2_size, rho);
+    }
+    sfnn_pcalm_eta_finalize_kernel<<<1, 32, 0, ctx->stream>>>(eta_buf->ptr, eta, eta_auto_scale);
+    if (check_kernel_launch("sfnn_pcalm init / eta launch") != 0) {
+        return -1;
+    }
+
+    for (size_t t = 0; t < steps; ++t) {
+        const int apply_dual = t > 0 ? 1 : 0;
+        sfnn_pcalm_tail_step_v2_kernel<<<tail_blocks, tail_threads, 0, ctx->stream>>>(
+            d2->ptr, lam2->ptr, g2->ptr, q2->ptr, l1->ptr, u->ptr, d3->ptr, lam3->ptr, p3->ptr, e3->ptr, lgrad->ptr,
+            w2_eff, w3_eff, buckets->ptr, batch, l1_hidden, l2_size, num_stacks, static_cast<float>(batch), alpha, rho,
+            eta_buf->ptr, apply_dual);
+        sfnn_pcalm_ft_step_q2_kernel<<<warp_blocks, threads, 0, ctx->stream>>>(
+            d1->ptr, lam1->ptr, g2->ptr, w1_eff, q2->ptr, buckets->ptr, batch, ft_size, l1_out, num_stacks, alpha, rho,
+            eta_buf->ptr, apply_dual);
+        sfnn_pcalm_tail_predict_v2_kernel<<<tail_blocks, tail_threads, 0, ctx->stream>>>(
+            l1->ptr, d2->ptr, l2_input->ptr, u->ptr, pre3_ref->ptr, p3->ptr, e3->ptr, d3->ptr, output->ptr, out->ptr,
+            w2_eff, b2_eff, w3_eff, buckets->ptr, batch, l1_hidden, l2_size, num_stacks, 0);
+        loss_sigmoid_mse_reduce_kernel<<<sample_blocks, threads, 0, ctx->stream>>>(
+            out->ptr, targets->ptr, entry_weights->ptr, lps->ptr, lgrad->ptr, output_inv_scale, batch);
+        if (check_kernel_launch("sfnn_pcalm inference step launch") != 0) {
+            return -1;
+        }
+    }
+
+    // Composite credit with the duals used by the final primal step.
+    const float scale = -1.0f / static_cast<float>(batch);
+    if (block_count_1d(batch * ft_size, threads, &blocks, "sfnn_pcalm_credit_h1_kernel") != 0) {
+        return -1;
+    }
+    // delta_1 into combined_gradients; lam1 becomes the absolute settled h1 for the L1 reduction.
+    sfnn_pcalm_credit_h1_kernel<<<blocks, threads, 0, ctx->stream>>>(
+        d1->ptr, lam1->ptr, combined->ptr, combined_gradients->ptr, batch * ft_size, rho, scale);
+    if (block_count_1d(batch * l1_out, threads, &blocks, "sfnn_pcalm_credit_kernel h2") != 0) {
+        return -1;
+    }
+    sfnn_pcalm_credit_kernel<<<blocks, threads, 0, ctx->stream>>>(
+        d2->ptr, q2->ptr, lam2->ptr, l1_gradients->ptr, batch * l1_out, rho, scale);
+    if (block_count_1d(batch * l2_size, threads, &blocks, "sfnn_pcalm_credit_kernel h3") != 0) {
+        return -1;
+    }
+    sfnn_pcalm_credit_kernel<<<blocks, threads, 0, ctx->stream>>>(
+        d3->ptr, e3->ptr, lam3->ptr, l2_gradients->ptr, batch * l2_size, rho, scale);
+    // lam3 is free now: absolute settled h3 = l2 + d3 for the L3 reduction.
+    sfnn_pcalm_add_kernel<<<blocks, threads, 0, ctx->stream>>>(l2->ptr, d3->ptr, lam3->ptr, batch * l2_size);
+    if (check_kernel_launch("sfnn_pcalm credit launch") != 0) {
+        return -1;
+    }
+
+    if (zero_parameter_gradients != 0) {
+        if (launch_zero_sfnn_backward_parameter_gradients(
+                ctx, input_size, ft_size, l1_hidden, l2_size, num_stacks, l1_group_count, l1_common_size,
+                l1_shard_size, factorizer_king_axis_dim, factorizer_hand_axis_dim, l0w_gradients->ptr,
+                l0b_gradients->ptr, l1w_gradients->ptr, l1b_gradients->ptr, l1fw_gradients->ptr,
+                l1fb_gradients->ptr, l1axw_gradients->ptr, l1axb_gradients->ptr, l2w_gradients->ptr,
+                l2b_gradients->ptr, l2fw_gradients->ptr, l2fb_gradients->ptr, l2axw_gradients->ptr,
+                l2axb_gradients->ptr, l3w_gradients->ptr, l3b_gradients->ptr, l3fw_gradients->ptr,
+                l3fb_gradients->ptr, l3axw_gradients->ptr, l3axb_gradients->ptr, 0) != 0) {
+            return -1;
+        }
+    }
+    // Weight gradients: the BP parameter reductions with injected adjoints and settled activations.
+    if (launch_sfnn_dense_param_reduce_tiled(
+            ctx, lam3->ptr, nullptr, lgrad->ptr, buckets->ptr, l3w_gradients->ptr, l3b_gradients->ptr,
+            has_l3f != 0 ? l3fw_gradients->ptr : nullptr, has_l3f != 0 ? l3fb_gradients->ptr : nullptr, batch,
+            l2_size, 1, num_stacks, has_l3f, 0, 0, "pcalm dense reduce L3 params") != 0) {
+        return -1;
+    }
+    if (launch_sfnn_dense_param_reduce_tiled(
+            ctx, u->ptr, p3->ptr, l2_gradients->ptr, buckets->ptr, l2w_gradients->ptr, l2b_gradients->ptr,
+            has_l2f != 0 ? l2fw_gradients->ptr : nullptr, has_l2f != 0 ? l2fb_gradients->ptr : nullptr, batch,
+            l2_in, l2_size, num_stacks, has_l2f, 0, 1, "pcalm dense reduce L2 params") != 0) {
+        return -1;
+    }
+    if (launch_sfnn_dense_param_reduce_tiled(
+            ctx, lam1->ptr, nullptr, l1_gradients->ptr, buckets->ptr, l1w_gradients->ptr, l1b_gradients->ptr,
+            has_l1f != 0 ? l1fw_gradients->ptr : nullptr, has_l1f != 0 ? l1fb_gradients->ptr : nullptr, batch,
+            ft_size, l1_out, num_stacks, has_l1f, 1, 0, "pcalm dense reduce L1 params") != 0) {
+        return -1;
+    }
+    if (launch_sfnn_inverse_index_l0_backward(
+            ctx, stm_indices->ptr, nstm_indices->ptr, stm_l0->ptr, nstm_l0->ptr, combined_gradients->ptr,
+            stm_l0_pre_gradients->ptr, nstm_l0_pre_gradients->ptr, l0w_gradients->ptr, l0b_gradients->ptr, batch,
+            max_active, input_size, ft_size) != 0) {
+        return -1;
+    }
+    return ok();
+}
diff --git a/crates/cuda_cpp/src/bin/pcalm_gradcheck.rs b/crates/cuda_cpp/src/bin/pcalm_gradcheck.rs
new file mode 100644
index 00000000..6a2a9439
--- /dev/null
+++ b/crates/cuda_cpp/src/bin/pcalm_gradcheck.rs
@@ -0,0 +1,201 @@
+//! fast_suisho experiment-011: gradient dump for validating the PC-ALM backward pass.
+//!
+//! Reads raw little-endian tensors written by `experiments/011-pcalm/m0/gradcheck.py` from `<dir>`:
+//! weights `l0w.f32 l0b.f32 l1w.f32 l1b.f32 l1fw.f32 l1fb.f32 l2w.f32 l2b.f32 l2fw.f32 l2fb.f32
+//! l3w.f32 l3b.f32 l3fw.f32 l3fb.f32` (SFNN HalfKA2 1024-7-64 k3k3, shared factorizer, unfolded) and
+//! a batch `stm.i32 nstm.i32` (B x 40 base features, -1 = empty), `buckets.i32`, `targets.f32`,
+//! `weights.f32`. Runs forward + sigmoid-MSE loss + one backward pass (BP or PC-ALM) and writes the
+//! parameter gradients to `<out>/<name>.f32` plus `loss.txt`.
+//!
+//!   pcalm_gradcheck <dir> <out> bp
+//!   pcalm_gradcheck <dir> <out> pcalm <steps> <alpha> <rho> <eta_h | auto:<scale>>
+
+use std::fs;
+use std::path::{Path, PathBuf};
+
+use bulletou_cuda_cpp::{
+    Context, F32Buffer, ScalarLossKind, ScalarLossWorkspace, ScalarLossWorkspaceLayout, SfnnBackwardWorkspace,
+    SfnnBackwardWorkspaceLayout, SfnnFactorizerActive, SfnnForwardDeviceBatch, SfnnForwardDeviceWeights,
+    SfnnForwardHostBatch, SfnnForwardHostWeights, SfnnForwardShape, SfnnForwardWorkspace, SfnnForwardWorkspaceLayout,
+    SfnnPcalmConfig, SfnnPcalmWorkspace,
+};
+
+fn read_f32(path: &Path) -> Vec<f32> {
+    let bytes = fs::read(path).unwrap_or_else(|e| panic!("{}: {e}", path.display()));
+    bytes.chunks_exact(4).map(|c| f32::from_le_bytes(c.try_into().unwrap())).collect()
+}
+
+fn read_i32(path: &Path) -> Vec<i32> {
+    let bytes = fs::read(path).unwrap_or_else(|e| panic!("{}: {e}", path.display()));
+    bytes.chunks_exact(4).map(|c| i32::from_le_bytes(c.try_into().unwrap())).collect()
+}
+
+fn write_f32(path: &Path, values: &[f32]) {
+    let mut bytes = Vec::with_capacity(values.len() * 4);
+    for v in values {
+        bytes.extend_from_slice(&v.to_le_bytes());
+    }
+    fs::write(path, bytes).unwrap_or_else(|e| panic!("{}: {e}", path.display()));
+}
+
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let args: Vec<String> = std::env::args().collect();
+    if args.len() < 4 {
+        return Err("usage: pcalm_gradcheck <dir> <out> bp | pcalm <steps> <alpha> <rho> <eta_h>".into());
+    }
+    let dir = PathBuf::from(&args[1]);
+    let out = PathBuf::from(&args[2]);
+    let mode = args[3].as_str();
+    fs::create_dir_all(&out)?;
+
+    let shape = SfnnForwardShape {
+        input_size: 131_949 + 1_629,
+        ft_size: 1024,
+        l1_hidden: 7,
+        l2_size: 64,
+        num_stacks: 9,
+        l1_group_count: 1,
+        l1_common_size: 0,
+        l1_shard_size: 0,
+        factorizer_king_axis_dim: 3,
+        factorizer_hand_axis_dim: 0,
+    };
+    let names = ["l0w", "l0b", "l1w", "l1b", "l1fw", "l1fb", "l2w", "l2b", "l2fw", "l2fb", "l3w", "l3b", "l3fw", "l3fb"];
+    let w: Vec<Vec<f32>> = names.iter().map(|n| read_f32(&dir.join(format!("{n}.f32")))).collect();
+    let host_weights = SfnnForwardHostWeights {
+        shape,
+        l0w: &w[0],
+        l0b: &w[1],
+        l1w: &w[2],
+        l1b: &w[3],
+        l1fw: Some(&w[4]),
+        l1fb: Some(&w[5]),
+        l1axw: None,
+        l1axb: None,
+        l2w: &w[6],
+        l2b: &w[7],
+        l2fw: Some(&w[8]),
+        l2fb: Some(&w[9]),
+        l2axw: None,
+        l2axb: None,
+        l3w: &w[10],
+        l3b: &w[11],
+        l3fw: Some(&w[12]),
+        l3fb: Some(&w[13]),
+        l3axw: None,
+        l3axb: None,
+    };
+    let stm = read_i32(&dir.join("stm.i32"));
+    let nstm = read_i32(&dir.join("nstm.i32"));
+    let buckets = read_i32(&dir.join("buckets.i32"));
+    let targets = read_f32(&dir.join("targets.f32"));
+    let entry_weights = read_f32(&dir.join("weights.f32"));
+    let batch_size = buckets.len();
+    let max_active = 40;
+
+    let ctx = Context::new(0)?;
+    let weights = SfnnForwardDeviceWeights::from_host(&ctx, host_weights)?;
+    let batch = SfnnForwardDeviceBatch::from_host(
+        &ctx,
+        SfnnForwardHostBatch { stm_indices: &stm, nstm_indices: &nstm, buckets: &buckets, batch_size, max_active },
+    )?;
+    let targets_dev = F32Buffer::from_host(&ctx, &targets)?;
+    let weights_dev = F32Buffer::from_host(&ctx, &entry_weights)?;
+    let forward = SfnnForwardWorkspace::new(&ctx, SfnnForwardWorkspaceLayout::new(shape, batch_size))?;
+    let loss = ScalarLossWorkspace::new(&ctx, ScalarLossWorkspaceLayout::new(batch_size))?;
+    let backward = SfnnBackwardWorkspace::new(&ctx, SfnnBackwardWorkspaceLayout::new(shape, batch_size, max_active))?;
+    for buf in [
+        &backward.l0w_gradients,
+        &backward.l0b_gradients,
+        &backward.l1w_gradients,
+        &backward.l1b_gradients,
+        &backward.l1fw_gradients,
+        &backward.l1fb_gradients,
+        &backward.l1axw_gradients,
+        &backward.l1axb_gradients,
+        &backward.l2w_gradients,
+        &backward.l2b_gradients,
+        &backward.l2fw_gradients,
+        &backward.l2fb_gradients,
+        &backward.l2axw_gradients,
+        &backward.l2axb_gradients,
+        &backward.l3w_gradients,
+        &backward.l3b_gradients,
+        &backward.l3fw_gradients,
+        &backward.l3fb_gradients,
+        &backward.l3axw_gradients,
+        &backward.l3axb_gradients,
+    ] {
+        buf.fill(&ctx, 0.0)?;
+    }
+    let factorizer = SfnnFactorizerActive::SHARED;
+    bulletou_cuda_cpp::sfnn_forward_device_with_factorizer(&ctx, &batch, &weights, &forward, factorizer)?;
+    bulletou_cuda_cpp::scalar_loss_device_from_buffers(
+        &ctx,
+        ScalarLossKind::SigmoidMse,
+        1.0,
+        batch_size,
+        &forward.output,
+        &targets_dev,
+        &weights_dev,
+        &loss,
+    )?;
+    match mode {
+        "bp" => bulletou_cuda_cpp::sfnn_backward_train_device_with_factorizer(
+            &ctx, &batch, &weights, &forward, &loss, &backward, factorizer,
+        )?,
+        "pcalm" => {
+            // eta: a number (fixed) or `auto:<scale>`
+            let (eta_h, eta_auto_scale) = match args[7].strip_prefix("auto:") {
+                Some(scale) => (0.0, scale.parse()?),
+                None => (args[7].parse()?, 0.0),
+            };
+            let config =
+                SfnnPcalmConfig { steps: args[4].parse()?, alpha: args[5].parse()?, rho: args[6].parse()?, eta_h, eta_auto_scale };
+            let ws = SfnnPcalmWorkspace::new(&ctx, shape, batch_size)?;
+            bulletou_cuda_cpp::sfnn_pcalm_backward_train_device(
+                &ctx,
+                &batch,
+                &weights,
+                &forward,
+                &loss,
+                &targets_dev,
+                &weights_dev,
+                ScalarLossKind::SigmoidMse,
+                1.0,
+                &backward,
+                &ws,
+                factorizer,
+                config,
+            )?;
+            let eta = ws.eta.download(&ctx)?;
+            fs::write(out.join("eta.txt"), format!("{} {} {} {}\n", eta[0], eta[1], eta[2], eta[3]))?;
+        }
+        other => return Err(format!("unknown mode {other}").into()),
+    }
+    let rb = backward.download(&ctx)?;
+    let grads: [(&str, &Vec<f32>); 14] = [
+        ("l0w", &rb.l0w_gradients),
+        ("l0b", &rb.l0b_gradients),
+        ("l1w", &rb.l1w_gradients),
+        ("l1b", &rb.l1b_gradients),
+        ("l1fw", &rb.l1fw_gradients),
+        ("l1fb", &rb.l1fb_gradients),
+        ("l2w", &rb.l2w_gradients),
+        ("l2b", &rb.l2b_gradients),
+        ("l2fw", &rb.l2fw_gradients),
+        ("l2fb", &rb.l2fb_gradients),
+        ("l3w", &rb.l3w_gradients),
+        ("l3b", &rb.l3b_gradients),
+        ("l3fw", &rb.l3fw_gradients),
+        ("l3fb", &rb.l3fb_gradients),
+    ];
+    for (name, g) in grads {
+        write_f32(&out.join(format!("{name}.f32")), g);
+    }
+    write_f32(&out.join("output.f32"), &forward.output.download(&ctx)?);
+    let lr = loss.download(&ctx)?;
+    fs::write(out.join("loss.txt"), format!("{}\n", lr.mean))?;
+    println!("{mode}: batch={batch_size} loss={} -> {}", lr.mean, out.display());
+    Ok(())
+}

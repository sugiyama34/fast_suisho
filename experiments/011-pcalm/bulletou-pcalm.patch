index 9ccab528..033a7f3e 100644
--- a/crates/cuda_cpp/src/lib.rs
+++ b/crates/cuda_cpp/src/lib.rs
@@ -3028,6 +3028,230 @@ fn sfnn_backward_device_impl(
     check(rc)
 }
 
+/// fast_suisho experiment-011 local patch: PC-ALM (Augmented Lagrangian Predictive Coding) settings.
+/// `alpha = 0` is plain predictive coding. See `bulletou_cuda_cpp_sfnn_pcalm_backward_train_device`.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct SfnnPcalmConfig {
+    pub steps: usize,
+    pub alpha: f32,
+    pub rho: f32,
+    pub eta_h: f32,
+}
+
+impl SfnnPcalmConfig {
+    pub fn validate(self) -> Result<()> {
+        if self.steps == 0 {
+            return Err(CudaCppError::message("PC-ALM steps must be at least 1"));
+        }
+        if !(self.alpha.is_finite() && self.alpha >= 0.0) {
+            return Err(CudaCppError::message("PC-ALM alpha must be finite and >= 0"));
+        }
+        if !(self.rho.is_finite() && self.rho >= 0.0) {
+            return Err(CudaCppError::message("PC-ALM rho must be finite and >= 0"));
+        }
+        if !(self.eta_h.is_finite() && self.eta_h > 0.0) {
+            return Err(CudaCppError::message("PC-ALM eta_h must be finite and > 0"));
+        }
+        Ok(())
+    }
+}
+
+/// Per-batch PC-ALM state buffers (states, duals, predictions). Not persisted in checkpoints:
+/// the duals restart from zero for every mini-batch.
+#[derive(Debug)]
+pub struct SfnnPcalmWorkspace {
+    pub h1: F32Buffer,
+    pub lam1: F32Buffer,
+    pub h2: F32Buffer,
+    pub lam2: F32Buffer,
+    pub p2: F32Buffer,
+    pub g2: F32Buffer,
+    pub u: F32Buffer,
+    pub h3: F32Buffer,
+    pub lam3: F32Buffer,
+    pub p3: F32Buffer,
+    pub out: F32Buffer,
+    pub lgrad: F32Buffer,
+    pub lps: F32Buffer,
+    pub l1w_eff: F32Buffer,
+    pub l1b_eff: F32Buffer,
+}
+
+impl SfnnPcalmWorkspace {
+    pub fn new(ctx: &Context, shape: SfnnForwardShape, batch_size: usize) -> Result<Self> {
+        let l1_out = shape.l1_hidden + 1;
+        let l2_in = shape.l1_hidden * 2;
+        let ft = batch_size * shape.ft_size;
+        Ok(Self {
+            h1: F32Buffer::new(ctx, ft)?,
+            lam1: F32Buffer::new(ctx, ft)?,
+            h2: F32Buffer::new(ctx, batch_size * l1_out)?,
+            lam2: F32Buffer::new(ctx, batch_size * l1_out)?,
+            p2: F32Buffer::new(ctx, batch_size * l1_out)?,
+            g2: F32Buffer::new(ctx, batch_size * l1_out)?,
+            u: F32Buffer::new(ctx, batch_size * l2_in)?,
+            h3: F32Buffer::new(ctx, batch_size * shape.l2_size)?,
+            lam3: F32Buffer::new(ctx, batch_size * shape.l2_size)?,
+            p3: F32Buffer::new(ctx, batch_size * shape.l2_size)?,
+            out: F32Buffer::new(ctx, batch_size)?,
+            lgrad: F32Buffer::new(ctx, batch_size)?,

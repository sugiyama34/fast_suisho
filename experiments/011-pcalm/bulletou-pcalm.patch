+/// fast_suisho experiment-011 local patch: PC-ALM (Augmented Lagrangian Predictive Coding) settings.
+/// `alpha = 0` is plain predictive coding. See `bulletou_cuda_cpp_sfnn_pcalm_backward_train_device`.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct SfnnPcalmConfig {
+    pub steps: usize,
+    pub alpha: f32,
+    pub rho: f32,
+    /// Fixed state step size (used when `eta_auto_scale <= 0`).
+    pub eta_h: f32,
+    /// `> 0`: recompute eta every mini-batch as `eta_auto_scale / (1.05 * lambda_max estimate)` from the
+    /// current weights (the reference rule eta = 1 / lambda_max, tracked as the weights grow).
+    pub eta_auto_scale: f32,
+}
+
+impl SfnnPcalmConfig {
+    pub fn validate(self) -> Result<()> {
+        if self.steps == 0 {
+            return Err(CudaCppError::message("PC-ALM steps must be at least 1"));
+        }
+        if !(self.alpha.is_finite() && self.alpha >= 0.0) {
+            return Err(CudaCppError::message("PC-ALM alpha must be finite and >= 0"));
+        }
+        if !(self.rho.is_finite() && self.rho >= 0.0) {
+            return Err(CudaCppError::message("PC-ALM rho must be finite and >= 0"));
+        }
+        if !(self.eta_auto_scale.is_finite() && self.eta_auto_scale >= 0.0) {
+            return Err(CudaCppError::message("PC-ALM eta_auto_scale must be finite and >= 0"));
+        }
+        if self.eta_auto_scale == 0.0 && !(self.eta_h.is_finite() && self.eta_h > 0.0) {
+            return Err(CudaCppError::message("PC-ALM eta_h must be finite and > 0 (or use eta_auto_scale)"));
+        }
+        Ok(())
+    }
+}
+
+/// Per-batch PC-ALM state buffers (offsets of the states from the forward pass, duals, predictions).
+/// Not persisted in checkpoints: the duals restart from zero for every mini-batch.
+#[derive(Debug)]
+pub struct SfnnPcalmWorkspace {
+    pub d1: F32Buffer,
+    pub lam1: F32Buffer,
+    pub d2: F32Buffer,
+    pub lam2: F32Buffer,
+    pub q2: F32Buffer,
+    pub g2: F32Buffer,
+    pub u: F32Buffer,
+    pub d3: F32Buffer,
+    pub lam3: F32Buffer,
+    pub p3: F32Buffer,
+    pub e3: F32Buffer,
+    pub pre3_ref: F32Buffer,
+    pub out: F32Buffer,
+    pub lgrad: F32Buffer,
+    pub lps: F32Buffer,
+    pub w1_eff: F32Buffer,
+    pub eta: F32Buffer,
+}
+
+impl SfnnPcalmWorkspace {
+    pub fn new(ctx: &Context, shape: SfnnForwardShape, batch_size: usize) -> Result<Self> {
+        let b = batch_size;
+        let l1_out = shape.l1_hidden + 1;
+        let l2_in = shape.l1_hidden * 2;
+        let ft = b * shape.ft_size;
+        Ok(Self {
+            d1: F32Buffer::new(ctx, ft)?,
+            lam1: F32Buffer::new(ctx, ft)?,
+            d2: F32Buffer::new(ctx, b * l1_out)?,
+            lam2: F32Buffer::new(ctx, b * l1_out)?,
+            q2: F32Buffer::new(ctx, b * l1_out)?,
+            g2: F32Buffer::new(ctx, b * l1_out)?,
+            u: F32Buffer::new(ctx, b * l2_in)?,
+            d3: F32Buffer::new(ctx, b * shape.l2_size)?,
+            lam3: F32Buffer::new(ctx, b * shape.l2_size)?,
+            p3: F32Buffer::new(ctx, b * shape.l2_size)?,
+            e3: F32Buffer::new(ctx, b * shape.l2_size)?,
+            pre3_ref: F32Buffer::new(ctx, b * shape.l2_size)?,
+            out: F32Buffer::new(ctx, b)?,
+            lgrad: F32Buffer::new(ctx, b)?,
+            lps: F32Buffer::new(ctx, b)?,
+            w1_eff: F32Buffer::new(
+                ctx,
+                shape.num_stacks * (l1_out * shape.ft_size + shape.l2_size * l2_in + 2 * shape.l2_size),
+            )?,
+            eta: F32Buffer::new(ctx, 4)?,
+        })
+    }
+}
+
+/// Check that PC-ALM supports this SFNN configuration (dense stacked L1, no axis factorizer).
+pub fn sfnn_pcalm_check_supported(shape: SfnnForwardShape, factorizer: SfnnFactorizerActive) -> Result<()> {
+    if shape.has_compact_l1() {
+        return Err(CudaCppError::message("PC-ALM supports dense stacked SFNN L1 only (no grouped/common-shard L1)"));
+    }
+    if factorizer.any_axis() {
+        return Err(CudaCppError::message("PC-ALM does not support the SFNN axis factorizer"));
+    }
+    if shape.l1_hidden * 2 > 32 {
+        return Err(CudaCppError::message("PC-ALM: l1_hidden must be <= 16"));
+    }
+    Ok(())
+}

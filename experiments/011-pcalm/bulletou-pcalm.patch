+// ============================================================================
+// fast_suisho experiment-011 local patch: PC-ALM (Augmented Lagrangian
+// Predictive Coding, Seely & Gould 2026) credit assignment for SFNN.
+//
+// States lifted to free variables per sample: h1 = combined (pairwise output,
+// ft_size), h2 = l1 (l1_hidden + 1), h3 = l2 (l2_size, post-crelu).
+// Residuals r1 = h1 - combined_fwd, r2 = h2 - L1(h1), r3 = h3 - crelu(L2(u(h2))),
+// supervised term = per-sample sigmoid-MSE of out = L3(h3) + h2[l1_hidden].
+// The inference loop is the reference algorithm (pcalm/inference.py,
+// run_pcalm, weight_credit_timing = pre_dual_energy) with per-sample energy:
+// T primal steps h -= eta * grad_h, T-1 dual steps lambda += alpha * r applied
+// right before primal steps 2..T. Weight gradients are the BP weight-gradient
+// reductions with the BP adjoints replaced by -(rho * r_i + lambda_i) / batch
+// and activations replaced by the settled states.
+// Supported: dense stacked L1 with optional shared factorizer, no axis
+// factorizer, sigmoid-MSE loss (checked on the Rust side as well).
+// ============================================================================
+
+constexpr size_t SFNN_PCALM_MAX_L2_IN = 32;
+
+__device__ __forceinline__ float sfnn_pcalm_crelu_mask(float value) {
+    return value > 0.0f && value < 1.0f ? 1.0f : 0.0f;
+}
+
+// One thread per sample: dual (optional) + primal step for h3 and h2, and the
+// layer-2 composite credit g2 = rho * r2 + lambda2 used by the h1 step.
+__global__ void sfnn_pcalm_tail_step_kernel(
+    float* h2,
+    float* lam2,
+    float* g2_out,
+    const float* p2,
+    const float* u,
+    float* h3,
+    float* lam3,
+    const float* p3,
+    const float* lgrad_mean,
+    const float* l2w,
+    const float* l2fw,
+    const float* l3w,
+    const float* l3fw,
+    const int* buckets,
+    size_t batch,
+    size_t l1_hidden,
+    size_t l2_size,
+    size_t num_stacks,
+    float batch_scale,
+    float alpha,
+    float rho,
+    float eta,
+    int apply_dual) {
+    size_t sample = blockIdx.x * blockDim.x + threadIdx.x;
+    if (sample >= batch) {
+        return;
+    }
+    const size_t l1_out = l1_hidden + 1;
+    const size_t l2_in = l1_hidden * 2;
+    int stack_i32 = buckets[sample];
+    if (stack_i32 < 0 || static_cast<size_t>(stack_i32) >= num_stacks) {
+        for (size_t r = 0; r < l1_out; ++r) {
+            g2_out[sample * l1_out + r] = 0.0f;
+        }
+        return;
+    }
+    const size_t stack = static_cast<size_t>(stack_i32);
+    const float lg = lgrad_mean[sample] * batch_scale;
+
+    float back[SFNN_PCALM_MAX_L2_IN];
+    for (size_t i = 0; i < SFNN_PCALM_MAX_L2_IN; ++i) {
+        back[i] = 0.0f;
+    }
+    for (size_t o = 0; o < l2_size; ++o) {
+        const size_t idx = sample * l2_size + o;
+        const float r3 = h3[idx] - p3[idx];
+        float lm = lam3[idx];
+        if (apply_dual != 0) {
+            lm += alpha * r3;
+            lam3[idx] = lm;
+        }
+        const float g3 = rho * r3 + lm;
+        const float w3 = l3w[stack * l2_size + o] + (l3fw != nullptr ? l3fw[o] : 0.0f);
+        const float v = sfnn_pcalm_crelu_mask(p3[idx]) * g3;
+        if (v != 0.0f) {
+            const float* w2row = l2w + stack * l2_size * l2_in + o * l2_in;
+            const float* f2row = l2fw != nullptr ? l2fw + o * l2_in : nullptr;
+            for (size_t i = 0; i < l2_in; ++i) {
+                back[i] += v * (w2row[i] + (f2row != nullptr ? f2row[i] : 0.0f));
+            }
+        }
+        h3[idx] -= eta * (g3 + lg * w3);
+    }
+    for (size_t r = 0; r < l1_out; ++r) {
+        const size_t idx = sample * l1_out + r;
+        const float x = h2[idx];
+        const float r2 = x - p2[idx];
+        float lm = lam2[idx];
+        if (apply_dual != 0) {
+            lm += alpha * r2;
+            lam2[idx] = lm;
+        }
+        const float g = rho * r2 + lm;
+        g2_out[idx] = g;
+        float grad = 0.0f;
+        if (r < l1_hidden) {
+            const float sq = u[sample * l2_in + r];
+            const float lin = u[sample * l2_in + l1_hidden + r];
+            const float jt = back[r] * sfnn_pcalm_crelu_mask(sq) * (2.0f * x * SFNN_PAIRWISE_SCALE) +
+                back[l1_hidden + r] * sfnn_pcalm_crelu_mask(lin);
+            grad = g - jt;
+        } else {
+            grad = g + lg;  // L1 -> output shortcut
+        }
+        h2[idx] = x - eta * grad;
+    }
+}
+
+// One thread per (sample, ft unit): dual (optional) + primal step for h1.
+__global__ void sfnn_pcalm_ft_step_kernel(
+    float* h1,
+    float* lam1,
+    const float* combined_fwd,
+    const float* g2,
+    const float* l1w,
+    const float* l1fw,
+    const int* buckets,
+    size_t batch,
+    size_t ft_size,
+    size_t l1_out,
+    size_t num_stacks,
+    float alpha,
+    float rho,
+    float eta,
+    int apply_dual) {
+    size_t tid = blockIdx.x * blockDim.x + threadIdx.x;
+    if (tid >= batch * ft_size) {
+        return;
+    }
+    const size_t sample = tid / ft_size;
+    const size_t j = tid - sample * ft_size;
+    int stack_i32 = buckets[sample];
+    if (stack_i32 < 0 || static_cast<size_t>(stack_i32) >= num_stacks) {
+        return;
+    }
+    const size_t stack = static_cast<size_t>(stack_i32);
+    const float x = h1[tid];
+    const float r1 = x - combined_fwd[tid];
+    float lm = lam1[tid];
+    if (apply_dual != 0) {
+        lm += alpha * r1;
+        lam1[tid] = lm;
+    }
+    const float g1 = rho * r1 + lm;
+    const float* w = l1w + stack * l1_out * ft_size + j;
+    float back = 0.0f;
+    for (size_t k = 0; k < l1_out; ++k) {
+        const float wk = w[k * ft_size] + (l1fw != nullptr ? l1fw[j * l1_out + k] : 0.0f);
+        back += wk * g2[sample * l1_out + k];
+    }
+    h1[tid] = x - eta * (g1 - back);
+}
+
+// Effective L1 weights (stacked + shared factorizer), row-major [stack][out][in], built once per
+// mini-batch so the inference kernels read them coalesced.
+__global__ void sfnn_pcalm_l1_effective_kernel(
+    const float* l1w,
+    const float* l1fw,
+    const float* l1b,
+    const float* l1fb,
+    float* w_eff,
+    float* b_eff,
+    size_t ft_size,
+    size_t l1_out,
+    size_t num_stacks) {
+    size_t tid = blockIdx.x * blockDim.x + threadIdx.x;
+    const size_t per_stack = l1_out * ft_size;
+    if (tid < num_stacks * per_stack) {
+        const size_t rem = tid % per_stack;
+        const size_t o = rem / ft_size;
+        const size_t i = rem - o * ft_size;
+        w_eff[tid] = l1w[tid] + (l1fw != nullptr ? l1fw[i * l1_out + o] : 0.0f);
+    }
+    if (tid < num_stacks * l1_out) {
+        b_eff[tid] = l1b[tid] + (l1fb != nullptr ? l1fb[tid % l1_out] : 0.0f);
+    }
+}
+
+// p2 = L1(h1) with one warp per sample (coalesced reads of h1 and the effective weights).
+__global__ void sfnn_pcalm_l1_forward_warp_kernel(
+    const float* h1,
+    const float* w_eff,
+    const float* b_eff,
+    const int* buckets,
+    float* p2,
+    size_t batch,
+    size_t ft_size,
+    size_t l1_out,
+    size_t num_stacks) {
+    const size_t warp = (static_cast<size_t>(blockIdx.x) * blockDim.x + threadIdx.x) / 32;
+    const unsigned int lane = threadIdx.x & 31U;
+    if (warp >= batch) {
+        return;
+    }
+    const size_t sample = warp;
+    int stack_i32 = buckets[sample];
+    if (stack_i32 < 0 || static_cast<size_t>(stack_i32) >= num_stacks) {
+        if (lane < l1_out) {
+            p2[sample * l1_out + lane] = 0.0f;
+        }
+        return;
+    }
+    const size_t stack = static_cast<size_t>(stack_i32);
+    const float* x = h1 + sample * ft_size;
+    for (size_t o = 0; o < l1_out; ++o) {
+        const float* w = w_eff + (stack * l1_out + o) * ft_size;
+        float acc = 0.0f;
+        for (size_t i = lane; i < ft_size; i += 32) {
+            acc += x[i] * w[i];
+        }
+        for (int off = 16; off > 0; off >>= 1) {
+            acc += __shfl_down_sync(0xffffffffU, acc, off);
+        }
+        if (lane == 0) {
+            p2[sample * l1_out + o] = acc + b_eff[stack * l1_out + o];
+        }
+    }
+}
+
+// delta = scale * (rho * (h - pred) + lambda); scale = -1 / batch turns the
+// per-sample composite credit into a batch-mean BP-style output gradient.
+__global__ void sfnn_pcalm_credit_kernel(
+    const float* h,
+    const float* lam,
+    const float* pred,
+    float* delta,
+    size_t len,
+    float rho,
+    float scale) {
+    size_t tid = blockIdx.x * blockDim.x + threadIdx.x;
+    if (tid >= len) {
+        return;
+    }
+    delta[tid] = scale * (rho * (h[tid] - pred[tid]) + lam[tid]);
+}
+
+int sfnn_pcalm_copy(BulletOuCudaCppContext* ctx, float* dst, const float* src, size_t len, const char* label) {
+    if (len == 0) {
+        return 0;
+    }
+    cudaError_t status = cudaMemcpyAsync(dst, src, len * sizeof(float), cudaMemcpyDeviceToDevice, ctx->stream);
+    if (status != cudaSuccess) {
+        return fail(label, status);
+    }
+    return 0;
+}
+
+int sfnn_pcalm_zero(BulletOuCudaCppContext* ctx, float* dst, size_t len, const char* label) {
+    if (len == 0) {
+        return 0;
+    }
+    cudaError_t status = cudaMemsetAsync(dst, 0, len * sizeof(float), ctx->stream);
+    if (status != cudaSuccess) {
+        return fail(label, status);
+    }
+    return 0;
+}
+
+// Predictions at the current states: p2 = L1(h1), u = u(h2), p3 = crelu(L2(u)),
+// out = L3(h3) + h2[l1_hidden], lgrad_mean = d(batch-mean loss)/d out.
+int sfnn_pcalm_predictions(
+    BulletOuCudaCppContext* ctx,
+    size_t ft_size,
+    size_t l1_hidden,
+    size_t l2_size,
+    size_t num_stacks,
+    size_t factorizer_king_axis_dim,
+    size_t factorizer_hand_axis_dim,
+    size_t batch,
+    const int* buckets,
+    const float* l1w,
+    const float* l1b,
+    const float* l1fw,
+    const float* l1fb,
+    int has_l1f,
+    const float* l2w,
+    const float* l2b,
+    const float* l2fw,
+    const float* l2fb,
+    int has_l2f,
+    const float* l3w,
+    const float* l3b,
+    const float* l3fw,
+    const float* l3fb,
+    int has_l3f,
+    const float* targets,
+    const float* entry_weights,
+    float output_inv_scale,
+    const float* l1w_eff,
+    const float* l1b_eff,
+    const float* h1,
+    const float* h2,
+    const float* h3,
+    float* p2,
+    float* u,
+    float* p3,
+    float* out,
+    float* lps,
+    float* lgrad_mean) {
+    constexpr int threads = 256;
+    int blocks = 0;
+    const size_t l1_out = l1_hidden + 1;
+    const size_t l2_in = l1_hidden * 2;
+    if (block_count_1d(batch * 32, threads, &blocks, "pcalm sfnn_pcalm_l1_forward_warp_kernel") != 0) {
+        return -1;
+    }
+    sfnn_pcalm_l1_forward_warp_kernel<<<blocks, threads, 0, ctx->stream>>>(
+        h1, l1w_eff, l1b_eff, buckets, p2, batch, ft_size, l1_out, num_stacks);
+    if (check_kernel_launch("pcalm sfnn_pcalm_l1_forward_warp_kernel launch") != 0) {
+        return -1;
+    }
+    if (block_count_1d(batch * l2_in, threads, &blocks, "pcalm sfnn_l2_input_kernel") != 0) {
+        return -1;
+    }
+    sfnn_l2_input_kernel<<<blocks, threads, 0, ctx->stream>>>(h2, u, batch, l1_hidden);
+    if (check_kernel_launch("pcalm sfnn_l2_input_kernel launch") != 0) {
+        return -1;
+    }
+    if (block_count_1d(batch * l2_size, threads, &blocks, "pcalm sfnn_stacked_l2_crelu_kernel") != 0) {
+        return -1;
+    }
+    sfnn_stacked_l2_crelu_kernel<<<blocks, threads, 0, ctx->stream>>>(
+        u, l2w, l2b, l2fw, l2fb, nullptr, nullptr, buckets, p3, batch, l2_in, l2_size, num_stacks,
+        factorizer_king_axis_dim, factorizer_hand_axis_dim, has_l2f, 0, 0, 0);
+    if (check_kernel_launch("pcalm sfnn_stacked_l2_crelu_kernel launch") != 0) {
+        return -1;
+    }
+    if (block_count_1d(batch, threads, &blocks, "pcalm sfnn_stacked_l3_output_kernel") != 0) {
+        return -1;
+    }
+    sfnn_stacked_l3_output_kernel<<<blocks, threads, 0, ctx->stream>>>(
+        h3, h2, l3w, l3b, l3fw, l3fb, nullptr, nullptr, buckets, out, batch, l2_size, l1_hidden, num_stacks,
+        factorizer_king_axis_dim, factorizer_hand_axis_dim, has_l3f, 0, 0, 0);
+    if (check_kernel_launch("pcalm sfnn_stacked_l3_output_kernel launch") != 0) {
+        return -1;
+    }
+    loss_sigmoid_mse_reduce_kernel<<<blocks, threads, 0, ctx->stream>>>(
+        out, targets, entry_weights, lps, lgrad_mean, output_inv_scale, batch);
+    if (check_kernel_launch("pcalm loss_sigmoid_mse_reduce_kernel launch") != 0) {
+        return -1;
+    }
+    return 0;
+}
